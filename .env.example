NEXT_PUBLIC_DEVELOPER_NAME=Developer name
NEXT_PUBLIC_MODERATOR_NAME=Moderator name
NEXT_PUBLIC_ANNOUNCEMENT_TITLE=Announcement title
NEXT_PUBLIC_ANNOUNCEMENT_DATE=Announcement date
NEXT_PUBLIC_ANNOUNCEMENT_CONTENT=Announcement content
