# Supabase: create a project and copy its URL and keys from Project Settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional site integrations. Replace example values only when configuring them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
RESEND_API_KEY=replace-with-resend-api-key
ADMIN_FROM_EMAIL=Server Admin <noreply@example.com>
UDDOKTAPAY_BASE_URL=https://payment-provider.example/api
UDDOKTAPAY_API_KEY=replace-with-payment-provider-key
UDDOKTAPAY_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
MINECRAFT_SERVER_PLUGIN_API_KEY=replace-with-a-long-random-plugin-key

