NEXT_PUBLIC_MINECRAFT_VERSION=Supported version
NEXT_PUBLIC_SERVER_REGION=Your region
NEXT_PUBLIC_PLAYER_COUNT=Configure player count
NEXT_PUBLIC_SERVER_UPTIME=Configure uptime
NEXT_PUBLIC_SERVER_RATING=Configure rating
NEXT_PUBLIC_LAUNCH_DATE=Add launch date
NEXT_PUBLIC_OWNER_NAME=Owner name
